# Supabase project (a NEW project, separate from Autoelektroservis Šabić)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for `npm run db:migrate` (Project Settings → Database → Connection string → URI)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Package shown on localhost and preview URLs (volt | gear | body | wheel | fleet | moto)
NEXT_PUBLIC_DEFAULT_PACKAGE=volt

# Public base URL used in customer approval links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seed
DEMO_PASSWORD=Demo2026!
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Days of free trial for self-registered workshops
TRIAL_DAYS=30

# Shown to a locked workshop (suspended or trial ended)
SUPPORT_EMAIL=
SUPPORT_PHONE=
