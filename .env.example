# Supabase project (a NEW project, separate from Autoelektroservis Šabić)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for `npm run db:migrate`: "Connect" → Session pooler (IPv4; the
# direct db.<ref>.supabase.co host is IPv6-only). The password goes separately below.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=

# Package shown on localhost and preview URLs (volt | gear | body | wheel | fleet | moto)
NEXT_PUBLIC_DEFAULT_PACKAGE=volt

# Public base URL used in customer approval links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seed
DEMO_PASSWORD=Demo2026!
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Days of free trial for self-registered workshops
TRIAL_DAYS=30

# TaktiX support. The phone (WhatsApp) shows on the landing page, login,
# registration, Postavke → Pomoć and the locked screen; nothing shows while empty.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Who workshops pay the subscription to (bank transfer, HUB-3 barcode).
# Without IBAN and name the payment slip is not shown. Name, address and
# OIB also identify the provider on /uvjeti, /privatnost, /obrada-podataka.
TAKTIX_IBAN=
TAKTIX_PAYEE_NAME=
TAKTIX_PAYEE_STREET=
TAKTIX_PAYEE_CITY=
TAKTIX_OIB=

# The Android app on Google Play (Trusted Web Activity, see docs/GOOGLE_PLAY.md).
# Package name and the SHA-256 fingerprints (comma-separated) from Play Console
# → App integrity; served at /.well-known/assetlinks.json.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# E-mail from the app (password reset, later sign-up confirmation) goes out
# through Supabase with Brevo as the sender (docs/EMAIL_BREVO.md). Set
# AUTH_EMAIL=1 once that works; until then "Zaboravili ste lozinku?" leads
# to WhatsApp and the tower sets a new password.
AUTH_EMAIL=

# E-mail from the app itself (e.g. "Novi termin" to the owner) through
# Brevo's API: Brevo → SMTP & API → API keys. MAIL_FROM must be a sender
# verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=TaktiX

# AI phone agent (Vapi, docs/VAPI.md): the shared secret of the server URL
# and the assistant's id. Each workshop's Vapi number is set in the tower.
VAPI_SERVER_SECRET=
VAPI_ASSISTANT_ID=

# Self-registration protection. Set REGISTRATION_EMAIL_CONFIRM=1 once custom
# SMTP is configured in Supabase (Authentication → Emails → SMTP) and
# "Confirm email" is on: new accounts then confirm their address first.
REGISTRATION_EMAIL_CONFIRM=
REGISTRATION_PER_HOUR=5
REGISTRATION_DAILY_LIMIT=100

# AI Kopilot (console.anthropic.com → API keys). Without a key the button
# explains that the Kopilot is not switched on.
ANTHROPIC_API_KEY=
# claude-sonnet-5 is fast (first words in ~1–2 s); claude-opus-5-5 is the most capable
AI_COPILOT_MODEL=claude-sonnet-5
# Answers per workshop per day
AI_DAILY_LIMIT=150
