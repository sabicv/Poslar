# Supabase project (a NEW project, separate from Autoelektroservis Šabić)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for `npm run db:migrate`: "Connect" → Session pooler (IPv4; the
# direct db.<ref>.supabase.co host is IPv6-only). The password goes separately below.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=

# Package shown on localhost and preview URLs (volt | gear | body | wheel | fleet | machine | moto | marine | air | aqua | tow | deal | detail | electric | appliance | locksmith | pool | clean)
NEXT_PUBLIC_DEFAULT_PACKAGE=volt

# Public base URL used in customer approval links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seed
DEMO_PASSWORD=Demo2026!
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Days of free trial for self-registered workshops
TRIAL_DAYS=30

# Poslar support. The phone (WhatsApp) shows on the landing page, login,
# registration, Postavke → Pomoć and the locked screen; nothing shows while empty.
# Mailbox podrska@poslar.eu. ImprovMX also forwards info@ and vedran@ to the same inbox.
SUPPORT_EMAIL=podrska@poslar.eu
SUPPORT_PHONE=

# Who workshops pay the subscription to (bank transfer, HUB-3 barcode).
# Without IBAN and name the payment slip is not shown. Name, address and
# OIB also identify the provider on /uvjeti, /privatnost, /obrada-podataka.
# The older TAKTIX_* names still work.
POSLAR_IBAN=
POSLAR_PAYEE_NAME=
POSLAR_PAYEE_STREET=
POSLAR_PAYEE_CITY=
POSLAR_OIB=

# The Android app on Google Play (Trusted Web Activity, see docs/GOOGLE_PLAY.md).
# Package name and the SHA-256 fingerprints (comma-separated) from Play Console
# → App integrity; served at /.well-known/assetlinks.json.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# E-mail from the app (password reset, later sign-up confirmation) goes out
# through Supabase with Brevo as the sender (docs/EMAIL_BREVO.md). Set
# AUTH_EMAIL=1 once that works; until then "Zaboravili ste lozinku?" leads
# to WhatsApp and the tower sets a new password.
AUTH_EMAIL=

# E-mail from the app itself (e.g. "Novi termin" to the owner) through
# Brevo's API: Brevo → SMTP & API → API keys. MAIL_FROM must be a sender
# verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=podrska@poslar.eu
MAIL_FROM_NAME=Poslar

# The evening run (vercel.json crons: daily summary to owners, WhatsApp
# reminders). Any long random string; Vercel sends it with each run.
CRON_SECRET=

# Automatic WhatsApp messages to customers from the shared Poslar number
# (Meta Cloud API, docs/WHATSAPP.md). Not set: owners send them with one
# tap from their own WhatsApp, as before.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# The shared Poslar phone number (docs/VAPI.md, part 6): as owners see it,
# and its id at Vapi. Calls are matched by the mobile that forwarded them.
POSLAR_PHONE_NUMBER=
VAPI_SHARED_NUMBER_ID=

# The tower's storage meter limits: free (default) or pro.
SUPABASE_PLAN=

# Card payments for the subscription (Paddle, docs/PADDLE.md). Not set: the
# bank slip only, as before. A test_ client token means the sandbox.
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_BASIC=
PADDLE_PRICE_STANDARD=
PADDLE_PRICE_PREMIUM=
PADDLE_PRICE_BASIC_FOUNDER=
PADDLE_PRICE_STANDARD_FOUNDER=
PADDLE_PRICE_PREMIUM_FOUNDER=

# AI phone agent (Vapi, docs/VAPI.md): the shared secret of the server URL
# and the assistant's id. Each workshop's Vapi number is set in the tower.
VAPI_SERVER_SECRET=
VAPI_ASSISTANT_ID=

# OpenRouter (openrouter.ai). The key is a secret: .env.local and Vercel only.
# WhatsApp writes a draft reply with Sonnet and does not send it.
# The phone assistant calls Claude Haiku through Poslar (Vapi custom LLM).
# The same key reads registration cards, nameplates and tyre sidewalls.
OPENROUTER_API_KEY=
AI_WHATSAPP_MODEL=anthropic/claude-sonnet-4
AI_VAPI_MODEL=anthropic/claude-haiku-4.5
AI_SCAN_MODEL=anthropic/claude-sonnet-4

# Self-registration protection. Set REGISTRATION_EMAIL_CONFIRM=1 once custom
# SMTP is configured in Supabase (Authentication → Emails → SMTP) and
# "Confirm email" is on: new accounts then confirm their address first.
REGISTRATION_EMAIL_CONFIRM=
REGISTRATION_PER_HOUR=5
REGISTRATION_DAILY_LIMIT=100

# "Pitaj Poslara" (the Kopilot; console.anthropic.com → API keys). Without a key the button
# explains that it is not switched on.
ANTHROPIC_API_KEY=
# claude-sonnet-5 is fast (first words in ~1–2 s); claude-opus-5-5 is the most capable
AI_COPILOT_MODEL=claude-sonnet-5
# Answers per workshop per day
AI_DAILY_LIMIT=150
